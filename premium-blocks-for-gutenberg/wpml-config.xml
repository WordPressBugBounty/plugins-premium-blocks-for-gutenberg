<wpml-config>
    <gutenberg-blocks>
        <gutenberg-block type="premium/accordion" translate="1">
            <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
            <xpath>//p[@class='premium-accordion__desc']</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/banner" translate="1">
            <xpath>//img[@class='premium-banner__img']/@alt</xpath>
            <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
            <xpath>//p[@class='premium-banner__desc']</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/button" translate="1">
            <xpath>//a/@href</xpath>
            <xpath>//*[contains(@class,'premium-button-text-edit')]</xpath>
            <xpath>//a[contains(@class,'premium-button') and not(contains(@class,'premium-button-text-edit')) and not(.//*[contains(@class,'premium-button-text-edit')])]</xpath>
            <key name="btnText" />
        </gutenberg-block>
        <gutenberg-block type="premium/countup" translate="1">
            <xpath>//p</xpath>
            <xpath>//h3</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/dheading-block" translate="1">
            <xpath>//span</xpath>
            <xpath>//a/@href</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/heading" translate="1">
            <xpath>//span[contains(@class,'premium-title-text-title')]</xpath>
            <xpath>//*[contains(@class,'premium-title-container') or contains(@class,'premium-title-text-title')]/@title</xpath>
            <xpath>//*[@data-backgroundtext]/@data-backgroundtext</xpath>
            <key name="title" />
            <key name="BackText" />
        </gutenberg-block>
        <gutenberg-block type="premium/icon" translate="1">
            <xpath>//a/@href</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/icon-box" translate="1">
            <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
            <xpath>//p</xpath>
            <xpath>//a</xpath>
            <xpath>//a/@href</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/maps" translate="1">
            <xpath>//h3[@class="premium-maps__title"]</xpath>
            <xpath>//div[@class="premium-maps__wrap__desc"]</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/pricing-table" translate="1">
            <xpath>//span</xpath>
            <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
            <xpath>//strike</xpath>
            <xpath>//a/@href</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/container" translate="0"></gutenberg-block>
        <gutenberg-block type="premium/testimonial" translate="1">
            <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
            <xpath>//a/@href</xpath>
            <xpath>//p</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/video-box" translate="1">
            <xpath>//*[contains(@class,'premium-video-box__desc_text')]</xpath>
            <xpath>//*[contains(@class,'premium-video-box__caption_text')]</xpath>
            <key name="description" />
            <key name="caption" />
            <key name="uploadCaption" />
        </gutenberg-block>
        <gutenberg-block type="premium/fancy-text" translate="1">
            <xpath>//span[contains(@class,'premium-fancy-text-prefix-text')]</xpath>
            <xpath>//span[contains(@class,'premium-fancy-text-suffix-text')]</xpath>
            <xpath>//span[contains(@class,'premium-fancy-text-title-highlighted')]</xpath>
            <xpath>//li</xpath>
            <xpath>//*[@data-strings]/@data-strings</xpath>
            <key name="prefix" />
            <key name="suffix" />
            <key name="highlightedText" />
            <key name="repeaterFancyText">
                <key name="*">
                    <key name="title" />
                </key>
            </key>
        </gutenberg-block>
        <gutenberg-block type="premium/form" translate="1">
            <xpath>//button/span</xpath>
            <key name="buttonText" />
            <key name="successMessage" />
            <key name="errorMessage" />
        </gutenberg-block>
        <gutenberg-block type="premium/star-ratings" translate="1">
            <xpath>//span[contains(@class,'premium-star-ratings-title')]</xpath>
            <key name="rateTitle" />
        </gutenberg-block>
        <gutenberg-block type="premium/text" translate="1">
            <xpath>//*[contains(@class,'premium-text-wrap')]</xpath>
            <key name="text" />
        </gutenberg-block>
        <gutenberg-block type="premium/one-page-scroll" translate="1">
            <xpath>//li[contains(@class,'pbg-one-page-scroll-menu-item')]</xpath>
            <xpath>//*[contains(@class,'pbg-one-page-scroll-dot__tooltip')]</xpath>
            <key name="menuItems">
                <key name="*">
                    <key name="label" />
                </key>
            </key>
            <key name="navDots">
                <key name="*">
                    <key name="tooltip" />
                </key>
            </key>
        </gutenberg-block>
        <gutenberg-block type="premium/lottie" translate="1">
            <xpath>//a/@href</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/modal" translate="1">
            <xpath>//a/@href</xpath>
            <xpath>//span</xpath>
            <xpath>//h3[@class="premium-modal-box-modal-title"]</xpath>
            <xpath>//img[@class='premium-modal-trigger-img']/@alt</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/image-separator" translate="1">
            <xpath>//img/@alt</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/bullet-list" translate="1">
            <xpath>//span</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/person" translate="1">
            <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
			<xpath>//span[@class="premium-person__desc"]</xpath>
            <xpath>//img/@alt</xpath>
        </gutenberg-block>
        <gutenberg-block type="premium/content-switcher" translate="1">
            <xpath>//*[self::h1 or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]</xpath>
            <xpath>//div</xpath>
        </gutenberg-block>
    </gutenberg-blocks>
</wpml-config>